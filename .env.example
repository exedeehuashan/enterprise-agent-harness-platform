# Copy to .env (chmod 600) and replace every value. Never commit .env.
# Generate tokens with: openssl rand -base64 48 | tr '+/' '-_' | tr -d '=\n'

DB_PASSWORD=replace-with-your-local-password
# Used only when running the backend directly on the host (mvn spring-boot:run); Compose sets its own.
DB_USERNAME=agent_harness
DB_URL=jdbc:postgresql://localhost:5432/agent_harness

# API identities: 32-256 URL-safe characters, all distinct. Admin is required.
EAHP_SECURITY_ADMIN_TOKEN=replace-with-a-random-token-of-at-least-32-chars
EAHP_SECURITY_OPERATOR_TOKEN=replace-with-another-random-token-32-chars-min
EAHP_SECURITY_VIEWER_TOKEN=replace-with-a-third-random-token-32-chars-min

# Host ports (bound to 127.0.0.1 only).
EAHP_BACKEND_PORT=8080
EAHP_CONSOLE_PORT=8088

# QA runner (方案 4). "on" mounts the Docker socket into the backend; see docker-compose.qa.yml.
EAHP_QA_RUNNER=off
# Group that owns the Docker socket as seen by containers: 0 on Docker Desktop, often the "docker" group id on Linux.
DOCKER_SOCKET_GID=0

# Number of database dumps scripts/deploy.sh keeps in backups/ (newest first).
EAHP_BACKUP_KEEP=10

# Pull request triggers: poll GitHub every 5 minutes for open PRs of registered projects and run their trigger suites.
EAHP_GITHUB_POLL_ENABLED=false
# Optional read-only token for polling (raises the API rate limit; needed for private repositories). Write-back uses EAHP_GITHUB_WRITE_TOKEN below.
EAHP_GITHUB_TOKEN=

# QA write-back to GitHub (P30): a fine-grained token with "Commit statuses: write" and "Pull requests: write"
# on the tested repositories. Empty disables write-back; each project must also switch it on.
EAHP_GITHUB_WRITE_TOKEN=
# Public URL of the console, linked from GitHub commit statuses (optional).
EAHP_PUBLIC_URL=

# AI model for planning, AI failure analysis and AI test generation (P33/P34).
#   EAHP_AI_PROVIDER=mock       no model; deterministic answers (default)
#   EAHP_AI_PROVIDER=anthropic  Claude: set ANTHROPIC_API_KEY (model claude-opus-5-5 unless ANTHROPIC_MODEL is set)
#   EAHP_AI_PROVIDER=deepseek   DeepSeek: set DEEPSEEK_API_KEY (model deepseek-chat unless DEEPSEEK_MODEL is set)
# Startup fails if the chosen provider has no key, so a misconfiguration never silently falls back to the mock.
EAHP_AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Claude effort: low, medium, high, xhigh or max (more thorough, more tokens).
ANTHROPIC_EFFORT=medium
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Upper bound for all AI calls per UTC day (input + output tokens).
EAHP_AI_DAILY_TOKEN_BUDGET=500000

# Code agent (P35): Claude Code works on approver-registered repositories in this image (build: scripts/build-code-agent.sh).
# It uses ANTHROPIC_API_KEY above. Pushing a branch and opening a draft PR also needs EAHP_GITHUB_WRITE_TOKEN with
# "Contents: write" and "Pull requests: write". Leave the model empty for Claude Code's default.
EAHP_CODE_AGENT_IMAGE=eahp-code-agent:local
EAHP_CODE_AGENT_MODEL=
# Network egress of the code agent: proxy (only the hosts below, through EAHP) or open.
EAHP_CODE_AGENT_NETWORK=proxy
EAHP_CODE_AGENT_EGRESS_ALLOW=api.anthropic.com,repo.maven.apache.org,repo1.maven.org,registry.npmjs.org

# Email notifications (P41), optional: SMTP for email subscriptions. Slack, DingTalk, WeCom and Feishu robots are
# configured per subscription in the console (Administration → Notifications) and need nothing here.
EAHP_SMTP_HOST=
EAHP_SMTP_PORT=587
EAHP_SMTP_USERNAME=
EAHP_SMTP_PASSWORD=
EAHP_SMTP_FROM=
EAHP_SMTP_STARTTLS=true

# Backup-restore drills (P42): nightly at 04:15 UTC when the QA runner (Docker access) is on; "false" turns them off.
# scripts/restore.sh --drill checks a backup file by hand; scripts/restore.sh --production FILE restores one.
EAHP_BACKUP_DRILL_ENABLED=true

# Single sign-on (P46), optional. For a local Keycloak with test users: scripts/sso-dev.sh, then EAHP_SSO=on scripts/deploy.sh.
# For your organisation's OIDC provider instead: its issuer, where EAHP fetches its keys (default: <issuer>/protocol/openid-connect/certs)
# and its origin (allowed for the console's login calls). Register a public client "eahp-console" with PKCE (S256), redirect URI
# <console>/auth/callback, post-logout redirect URI <console>/ (so Sign out also ends the provider session), an audience mapper adding "eahp", and roles eahp-viewer / eahp-operator / eahp-approver.
EAHP_SSO=off
# Local Keycloak only: the address browsers use to reach it (default http://127.0.0.1:8180), and further console addresses
# allowed to sign in. To sign in from a phone over Tailscale, for example:
#   sudo tailscale serve --bg --https=8443 http://127.0.0.1:8180
#   EAHP_SSO_DEV_URL=https://<host>.<tailnet>.ts.net:8443
#   EAHP_CONSOLE_ORIGINS=https://<host>.<tailnet>.ts.net
# then run scripts/sso-dev.sh, recreate the keycloak container and redeploy.
EAHP_SSO_DEV_URL=
EAHP_CONSOLE_ORIGINS=
EAHP_SSO_ISSUER=
EAHP_SSO_JWKS_URI=
EAHP_SSO_ORIGIN=
